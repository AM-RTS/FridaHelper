# Release signing configuration for FridaHelper
# Copy this file to keystore.properties and fill in your values.
# DO NOT commit keystore.properties to version control.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore fridahelper-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias fridahelper
#
# Then fill in the values below:

storeFile=fridahelper-release.jks
storePassword=your_store_password
keyAlias=fridahelper
keyPassword=your_key_password
